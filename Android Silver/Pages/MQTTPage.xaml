<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Android_Silver.Pages.MQTTPage"
             Title="MQTTPage">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <HorizontalStackLayout>
            <Label Text="Введите токен"  VerticalOptions="Center"/>
            <Entry Text="{Binding Token}" WidthRequest="400" Margin="10,0"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout HorizontalOptions="Center">
            <Button Text="Подключиться" Command="{Binding ConnectCommand}" WidthRequest="150" Margin="0,20"/>
            <Button Text="Отправить" Command="{Binding SendCommand}" WidthRequest="150" Margin="0,20"/>
            <Button Text="Отправить Post" Command="{Binding SendPostCommand}" WidthRequest="150" Margin="0,20"/>
        </HorizontalStackLayout>
        <Label Text="{Binding SystemMessage}" HeightRequest="700" WidthRequest="300" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>