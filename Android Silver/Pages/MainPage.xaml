            <Button  ImageSource="{Binding CPictureSet.AddButs[3].Current}" Command="{Binding TimeBtnUpCommand4}"  Grid.Row="7" Grid.Column="14" 
             Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed3" Released="AddBut_Released3" IsVisible = "{Binding  CActivePagesEntities.IsTimePage}"/>
            <!--#endregion-->
            <!--#endregion-->

            <!--#region BootloaderPage -->
            <Button ImageSource="{Binding CPictureSet.BackButton.Current}" Style="{StaticResource BackBut}" 
                                Command="{Binding BootloaderBackCommand}" Pressed="BackButton_Pressed"  Released="BackButton_Released" 
                                                         IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Label Text="Обновление контроллера" Grid.Row="1" Grid.Column="2" 
                   Style="{StaticResource Title}"    IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"  />
            <!--#region Версии -->
            <Label Text="Текущая версия прошивки" Grid.Row="2" Grid.Column="0"  Style="{StaticResource UpdaterLabel}"
                                         IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="{Binding CFBs.CUpdater.FWVerCurWord}" Grid.Row="2" Grid.Column="8" Style="{StaticResource UpdaterLabel}"
                                                   IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="Новая версия прошивки" Grid.Row="3" Grid.Column="0"  Style="{StaticResource UpdaterLabel}"
                                IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="{Binding CFBs.CUpdater.FWVerNewWord}" Grid.Row="3" Grid.Column="8" Style="{StaticResource UpdaterLabel}"
                                          IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="Заводская версия прошивки" Grid.Row="4" Grid.Column="0"  Style="{StaticResource UpdaterLabel}"
                                IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="{Binding CFBs.CUpdater.FWVerBkpWord}" Grid.Row="4" Grid.Column="8" Style="{StaticResource UpdaterLabel}"
                                          IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <!--#endregion-->

            <!--#region Обновление и перезагрузка -->
            <Label Text="{Binding CFilesEntities.SystemMessage}" Grid.Row="6" Grid.Column="0" 
                                         Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Button Grid.Row="6" ImageSource="{Binding CPictureSet.DownloadBut.Current}" Command="{Binding DownloadCommand}" 
                                         Style="{StaticResource UpdaterBut}" Pressed="Download_Pressed" Released="Download_Released"  
                                         IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" IsEnabled="{Binding CFBs.CUpdater.NotIsUpdate}" />
            <Label Text="Загрузить .bin" Grid.Row="6" Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />

            <Label Text="Настройка автообновления" Grid.Row="7" Grid.Column="0"  Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Picker Grid.Row="7" Grid.Column="9" Grid.ColumnSpan="9" WidthRequest="180" Style="{StaticResource ConfPicker}"  
                  SelectedIndexChanged="Picker_SelectedIndexChanged" ItemsSource="{Binding CFBs.CUpdater.AutoUpdList}" SelectedIndex="{Binding CFBs.CUpdater.AutoUpdIndex}" 
                                                                                                                IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Label Text="Копирование прошивки на контроллер" Grid.Row="8" Grid.Column="0"  Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Button Grid.Row="8"  ImageSource="{Binding CPictureSet.UpdaterBut.Current}" Command="{Binding UpdateCommand}"
                     Style="{StaticResource UpdaterBut}" Pressed="Updater_Pressed" Released="Updater_Released" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Label Text="Копировать"  Grid.Row="8" Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="{Binding  CFBs.CUpdater.ResultPackets}" Grid.Row="9" Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <Label Text="Перезагрузка контроллера" Grid.Row="10" Grid.Column="0"  Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}"/>
            <Button Grid.Row="10" ImageSource="{Binding CPictureSet.ResetBut.Current}" Command="{Binding ResetCommand}"  Style="{StaticResource UpdaterBut}"
                                      Pressed="Reset_Pressed" Released="Reset_Released" IsVisible = "{Binding   CActivePagesEntities.IsBootloaderPage}"/>
            <Label Text="Перезагрузить" Grid.Row="10" Style="{StaticResource UpdaterLabel}" IsVisible = "{Binding CActivePagesEntities.IsBootloaderPage}" />
            <!--#endregion-->
            <!--#endregion-->
            
        </Grid>
    </ScrollView>
</ContentPage>