<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Android_Silver.Services"
             BackgroundImageSource="{Binding CPictureSet.Background}"
             x:Name="mPage"
             x:Class="Android_Silver.Pages.MainPage">
    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="MainPageLabel">
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="Grid.ColumnSpan" Value="7"/>
            <Setter Property="IsVisible" Value="{Binding CActivePagesEntities.IsMainPage}"/>
        </Style>
    </ContentPage.Resources>
     
    <ScrollView VerticalScrollBarVisibility="Always">
        <Grid x:Name="mainPageGrid" ColumnSpacing="20" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--#region StartPage -->
            <Label Text="{Binding EthernetEntities.EthernetMessage}" Grid.Row="2"  Style="{StaticResource CommonLabel}"
                   IsVisible="{Binding CActivePagesEntities.IsStartPage}" />
            <Border  Grid.Row="5" Grid.Column="3"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}">
                <Border.StrokeShape>
                    <RoundRectangle/>
                </Border.StrokeShape>
                <Entry Text="{Binding EthernetEntities.IP1}" Placeholder="192" Style="{StaticResource EntryIP}"/>
            </Border>
            <Border  Grid.Row="5" Grid.Column="6"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
                <Border.StrokeShape>
                    <RoundRectangle/>
                </Border.StrokeShape>
                <Entry Text="{Binding EthernetEntities.IP2}"  Placeholder="168" Style="{StaticResource EntryIP}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="9"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
                <Border.StrokeShape>
                    <RoundRectangle/>
                </Border.StrokeShape>
                <Entry Text="{Binding EthernetEntities.IP3}" Placeholder="0" Style="{StaticResource EntryIP}"/>
            </Border>
            <Border  Grid.Row="5" Grid.Column="12"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
                <Border.StrokeShape>
                    <RoundRectangle/>
                </Border.StrokeShape>
                <Entry Text="{Binding EthernetEntities.IP4}" Placeholder="50" Style="{StaticResource EntryIP}"/>
            </Border>
            <Button  ImageSource="{Binding CPictureSet.IPBut.Current}"  Command="{Binding StartPageConnectCommand}"  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="18"
                     Pressed="IPButton_Pressed" Released="IPButton_Released" Style="{StaticResource OKButBot}"
                                                 IsVisible="{Binding CActivePagesEntities.IsStartPage}" />
            <!--#endregion-->
            
            <!--#region MAIN PAGE -->
            <!--Текущее время-->
            <Label Text="{Binding CFBs.CTime.TimeInterface}"
                            TextColor="Black" FontSize="17" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="1" 
                                                                                                        VerticalOptions="Center" IsVisible="{Binding CActivePagesEntities.IsMainPage}"/>
            <!--Заголовочные статусы-->
            <Image Source="{Binding CPictureSet.FanHeader.Current}" Grid.Row="0"  Grid.Column="4" Style="{StaticResource MainPageHeader}"  IsVisible="{Binding CActivePagesEntities.IsMainPage}" />
            <Image Source="{Binding CPictureSet.RecupHeader.Current}" Grid.Row="0"  Grid.Column="6" Style="{StaticResource MainPageHeader}"   IsVisible="{Binding CActivePagesEntities.IsMainPage}"/>
            <Image Source="{Binding CPictureSet.FilterHeader.Current}" Grid.Row="0"  Grid.Column="8" Style="{StaticResource MainPageHeader}" IsVisible="{Binding CActivePagesEntities.IsMainPage}" />
            <Image Source="{Binding CPictureSet.EHeaterHeader.Current}" Grid.Row="0"  Grid.Column="10" Style="{StaticResource MainPageHeader}" IsVisible="{Binding CActivePagesEntities.IsMainPage}" />
            <!--Кнопка настроек-->
            <Button ImageSource="{Binding Source={x:Reference mPage}, Path=BindingContext.CPictureSet.SettingsButton.Current}" 
                             Command="{Binding Source={x:Reference mPage},Path=BindingContext.SettingsCommand}"  Style="{StaticResource HeaderBut}"
                             Pressed="Settings_Pressed"  Released="Settings_Released"  
                             IsVisible="{Binding CActivePagesEntities.IsMainPage}" />
            <!--#region Режим 1 -->
            <Button ImageSource="{Binding CPictureSet.Mode1Select.Current}"
                             Command="{Binding ChooseModeCommand}" Padding="0"
                            BackgroundColor="Transparent"
                             Grid.Row="1"  Grid.RowSpan="4" Grid.Column="0"    Grid.ColumnSpan="18" Pressed="ActiveMode_Pressed" Released="ActiveMode_Released"
                             IsVisible="{Binding Source={x:Reference mPage}, Path=BindingContext.CActivePagesEntities.IsMainPage}"/>
            <Image Source="{Binding CModesEntities.CMode1.ActiveModePicture}" Grid.Row="2"  Grid.Column="6"  Grid.ColumnSpan="6" WidthRequest="180"
                                                          IsVisible="{Binding CActivePagesEntities.IsMainPage}" InputTransparent="True"/>
            <Image Source="{Binding CPictureSet.IsMode2Active}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="18" WidthRequest="130" 
                                                                     IsVisible="{Binding CActivePagesEntities.IsMainPage}" InputTransparent="True"/>
            <!--#endregion-->
            <!--#region Уставки и температуры -->
            <VerticalStackLayout Grid.Row="6" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="9" InputTransparent="True">
                <Label  Text="Вентиляция" Style="{StaticResource MainPageLabel}" />
                <HorizontalStackLayout Grid.ColumnSpan="9" HorizontalOptions="Center">
                    <Image Source="{Binding  CPictureSet.FlowIcon}"   HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference mPage},Path=BindingContext.CActivePagesEntities.IsMainPage}" WidthRequest="30"/>
                    <Label Text="{Binding  CModesEntities.CMode1.SupplySP.Value, StringFormat='{0}%'}"  Style="{StaticResource MainPageLabel}"/>
                </HorizontalStackLayout>
                <Label Text="Уставка" Style="{StaticResource MainPageLabel}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="6" Grid.RowSpan="2" Grid.Column="8" Grid.ColumnSpan="9" InputTransparent="True">
                <Label Text="Температура" Style="{StaticResource MainPageLabel}"/>
                <HorizontalStackLayout Grid.ColumnSpan="9" HorizontalOptions="Center">
                    <Image Source="{Binding CPictureSet.TempIcon}" HorizontalOptions="Center"
                        IsVisible="{Binding Source={x:Reference mPage},Path=BindingContext.CActivePagesEntities.IsMainPage}" WidthRequest="20"/>
                    <Label Text="{Binding CModesEntities.CMode1.TempSP.Value,StringFormat='{0}°C'}" Style="{StaticResource MainPageLabel}" />
                </HorizontalStackLayout>
                <Label Text="Уставка"  Style="{StaticResource MainPageLabel}" />
            </VerticalStackLayout>
            <Label Grid.Row="8"  Grid.Column="0" Text="{Binding CFBs.CFans.SFlow,StringFormat='{0} куб/час'}" Style="{StaticResource MainPageLabel}"/>
            <Label Grid.Row="8"  Grid.Column="6" Text="{Binding CFBs.CSensors.RoomTemp.Value.Value, StringFormat='{0}°C помещение'}" Style="{StaticResource MainPageLabel}"/>
            <Label Grid.Row="8"  Grid.Column="12" Text="{Binding CFBs.CSensors.SupTemp.Value.Value,StringFormat='{0}°C канал'}" Style="{StaticResource MainPageLabel}"/>

            <HorizontalStackLayout Grid.Row="9" Grid.RowSpan="1"  Grid.Column="1" Grid.ColumnSpan="15"
                              IsVisible="{Binding Source={x:Reference mPage},Path=BindingContext.CActivePagesEntities.IsMainPage}">
                <Label Text="{Binding Source={x:Reference mPage},Path=BindingContext.EthernetEntities.SystemMessage}"/>
            </HorizontalStackLayout>
            <!--#endregion-->
            <!--#endregion-->

            <!--#region CHOOSE MODE PAGE -->
            <Button ImageSource="{Binding CPictureSet.BackButton.Current}" Style="{StaticResource BackBut}"
               Command="{Binding HomeCommand}" Pressed="BackButton_Pressed" Released="BackButton_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Label Text="Выбор режимов" Grid.Row="1"   Style="{StaticResource Title}"    IsVisible = "{Binding   CActivePagesEntities.IsChooseModePage}"/>
            
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[1].Current}"   Grid.Row="2"  Grid.Column="3" Style="{StaticResource ChooseModeBut}" 
               Command="{Binding MinModeCommand}"  Pressed="Min_Pressed" Released="Min_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[2].Current}"    Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource ChooseModeBut}"
               Command="{Binding NormalModeCommand}"  Pressed="Norm_Pressed" Released="Norm_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[3].Current}"     Grid.Row="2" Grid.Column="14" Style="{StaticResource ChooseModeBut}"
               Command="{Binding MaxModeCommand}"  Pressed="Max_Pressed" Released="Max_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[4].Current}"     Grid.Row="6"  Grid.Column="3"  Style="{StaticResource ChooseModeBut}"
               Command="{Binding KitchenModeCommand}"  Pressed="Kitchen_Pressed" Released="Kitchen_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[5].Current}"    Grid.Row="6" Grid.Column="8"  Grid.ColumnSpan="2" Style="{StaticResource ChooseModeBut}"
               Command="{Binding VacationModeCommand}"  Pressed="Vac_Pressed" Released="Vac_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding  CPictureSet.SelectModesPics[0].Current}"    Grid.Row="6"   Grid.Column="14" Style="{StaticResource ChooseModeBut}"
               Command="{Binding TurnOffModeCommand}"  Pressed="TurnOff_Pressed" Released="TurnOff_Released" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <Button ImageSource="{Binding CPictureSet.SelectModesPics[6].Current}" Grid.Row="8" Grid.Column="6" Grid.ColumnSpan="6" BackgroundColor="Transparent"
                   WidthRequest="250"  VerticalOptions="Center"  Pressed="Sheduler_Pressed" IsVisible="{Binding CActivePagesEntities.IsChooseModePage}"/>
            <!--IsToggled="{Binding  CFBs.OtherSettings.IsSpecMode, Mode=TwoWay}"-->
            <!--#endregion-->

            <!--#region LOADING PAGE -->
            <Button ImageSource="{Binding  CPictureSet.BackButton.Current}" Style="{StaticResource BackBut}"
            Command="{Binding HomeCommand}" Pressed="Home_Pressed" Released="Home_Released" IsVisible="{Binding CActivePagesEntities.IsLoadingPage}"/>
            <Button ImageSource="{Binding CPictureSet.BackButton.Current}"  Command="{Binding LoadingReturnCommand}" 
                Grid.Row="1" Grid.Column="0" Style="{StaticResource MiniButtons}" 
                            Pressed="BackButton_Pressed"  Released="BackButton_Released" IsVisible = "{Binding   CActivePagesEntities.IsLoadingPage}"/>
            <Image Source="{Binding  CPictureSet.LoadingPic}" IsVisible="{Binding CActivePagesEntities.IsLoadingPage}" MaximumWidthRequest="400"
                                                        Grid.Row="6"  Grid.RowSpan="1" Grid.Column="1" Grid.ColumnSpan="16"/>
            <Label Text="Загрузка" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="18" FontSize="30" IsVisible="{Binding CActivePagesEntities.IsLoadingPage}"/>
            <!--#endregion-->

            <!--#region SETPOINTS PAGE -->
            <!--#region Заголовок -->
            <Button ImageSource="{Binding CPictureSet.BackButton.Current}"  Command="{Binding SPReturnCommand}"  Style="{StaticResource BackBut}" 
             Pressed="BackButton_Pressed"  Released="BackButton_Released" IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="Настройка режимов" Grid.Row="1"   Style="{StaticResource Title}"    IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"  />
            <Button  ImageSource="{Binding CPictureSet.OkButton.Current}" Command="{Binding SPOkCommand}"
                       Style="{StaticResource OKBut}"  Pressed="OK_SPPressed" Released="Ok_SPReleased" IsVisible = "{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Button  ImageSource="{Binding CPictureSet.PrevButton.Current}"  Command="{Binding PrevSetPointsCommand}" 
                Grid.Row="3" Grid.Column="3" Style="{StaticResource MiniButtons}" 
                                                Pressed="Prev_SPPressed" Released="Prev_SPReleased" IsVisible = "{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Image Source="{Binding M1Values.ActiveModePicture}"  Grid.Row="3"  Grid.Column="8" Grid.ColumnSpan="2"
                   Style="{StaticResource SPIcons}" IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"/>
            <Button  ImageSource="{Binding CPictureSet.NextButton.Current}"  Command="{Binding NextSetPointsCommand}" 
                      Grid.Row="3" Grid.Column="14" Style="{StaticResource MiniButtons}" 
                      Pressed="Next_Pressed" Released="Next_Released" IsVisible = "{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <!--#endregion-->
            <!--#region 1 ряд SypplySP-->
            <Button  ImageSource="{Binding  CPictureSet.SubButs[0].Current}"  Command="{Binding SPSub0Command}"    Grid.Row="4" Grid.Column="3"
                 Style="{StaticResource MiniButtons}" Pressed="SubBut_Pressed0" Released="SubBut_Released0" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <Image Source="{Binding CPictureSet.StrokeImg}"  Grid.Row="4"  Style="{StaticResource SpBackground}"
                                IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="Расход"  Grid.Row="4" Style="{StaticResource SPsNames}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="{Binding M1Values.SupplySP.Value, StringFormat='{0}%'}"  Grid.Row="4" Style="{StaticResource SPsText}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.AddButs[0].Current}" Command="{Binding SPAdd0Command}"  Grid.Row="4" Grid.Column="14"
                 Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed0" Released="AddBut_Released0" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <!--#endregion-->
            <!--#region 2 ряд ESP-->
            <Button  ImageSource="{Binding  CPictureSet.SubButs[1].Current}"  Command="{Binding SPSub1Command}"   Grid.Row="5" Grid.Column="3"
                Style="{StaticResource MiniButtons}" Pressed="SubBut_Pressed1" Released="SubBut_Released1" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <Image Source="{Binding CPictureSet.StrokeImg}"  Grid.Row="5"  Style="{StaticResource SpBackground}"
                     IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="Дисбаланс вытяжки"  Grid.Row="5" Style="{StaticResource SPsNames}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="{Binding M1Values.ExhaustDisb.Value, StringFormat='{0}%'}"  Grid.Row="5" Style="{StaticResource SPsText}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.AddButs[1].Current}" Command="{Binding SPAdd1Command}"  Grid.Row="5" Grid.Column="14"
                Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed1" Released="AddBut_Released1" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <!--#endregion-->
            <!--#region 3 ряд TempSP-->
            <Button  ImageSource="{Binding  CPictureSet.SubButs[2].Current}"  Command="{Binding SPSub2Command}"    Grid.Row="6" Grid.Column="3"
                 Style="{StaticResource MiniButtons}" Pressed="SubBut_Pressed2" Released="SubBut_Released2" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <Image Source="{Binding CPictureSet.StrokeImg}"  Grid.Row="6"  Style="{StaticResource SpBackground}"
                     IsVisible = "{Binding   CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="Температура"  Grid.Row="6" Style="{StaticResource SPsNames}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Label Text="{Binding M1Values.TempSP.Value, StringFormat='{0}°C'}"  Grid.Row="6" Style="{StaticResource SPsText}"  IsVisible="{Binding CActivePagesEntities.IsSetPointsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.AddButs[2].Current}" Command="{Binding SPAdd2Command}"  Grid.Row="6" Grid.Column="14"
                Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed2" Released="AddBut_Released2" IsVisible = "{Binding  CActivePagesEntities.IsSetPointsPage}"/>
            <!--#endregion-->
            <!--#region 4 ряд CorrSP-->
            <Button  ImageSource="{Binding  CPictureSet.SubButs[3].Current}"  Command="{Binding SPSub3Command}"    Grid.Row="7" Grid.Column="3"
                 Style="{StaticResource MiniButtons}" Pressed="SubBut_Pressed3" Released="SubBut_Released3" 
                                                                                    IsVisible = "{Binding  CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Image Source="{Binding CPictureSet.StrokeImg}"  Grid.Row="7"  Style="{StaticResource SpBackground}"
                                                                                     IsVisible = "{Binding   CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Label Text="Корректор притока"  Grid.Row="7" Style="{StaticResource SPsNames}"  IsVisible="{Binding CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Label Text="{Binding M1Values.SFanCorr.Value, StringFormat='{0}%'}"  Grid.Row="7" Style="{StaticResource SPsText}"  IsVisible="{Binding CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.AddButs[3].Current}" Command="{Binding SPAdd3Command}"  Grid.Row="7" Grid.Column="14"
            Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed3" Released="AddBut_Released3" IsVisible = "{Binding  CActivePagesEntities.IsCorrSetPointsPage}"/>
            <!--#endregion-->
            <!--#region 5 ряд CorrE-->
            <Button  ImageSource="{Binding  CPictureSet.SubButs[4].Current}"  Command="{Binding SPSub4Command}"    Grid.Row="8" Grid.Column="3"
                 Style="{StaticResource MiniButtons}" Pressed="SubBut_Pressed4" Released="SubBut_Released4" IsVisible = "{Binding  CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Image Source="{Binding CPictureSet.StrokeImg}"  Grid.Row="8"  Style="{StaticResource SpBackground}"
                                                                                IsVisible = "{Binding   CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Label Text="Корректор вытяжки"  Grid.Row="8" Style="{StaticResource SPsNames}"  IsVisible="{Binding CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Label Text="{Binding M1Values.EFanCorr.Value, StringFormat='{0}%'}"  Grid.Row="8" Style="{StaticResource SPsText}"  IsVisible="{Binding CActivePagesEntities.IsCorrSetPointsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.AddButs[4].Current}" Command="{Binding SPAdd4Command}"  Grid.Row="8" Grid.Column="14"
            Style="{StaticResource MiniButtons}" Pressed="AddBut_Pressed4" Released="Addbut_Released4" IsVisible = "{Binding  CActivePagesEntities.IsCorrSetPointsPage}"/>
            <!--#endregion-->
            <!--#endregion-->

            <!--#region SETTINGS PAGE -->
            <Button  ImageSource="{Binding  CPictureSet.BackButton.Current}" Style="{StaticResource BackBut}"
                Command="{Binding HomeCommand}" Pressed="BackButton_Pressed" Released="BackButton_Released" IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <!--#region Верхний уровень -->
            <Button  ImageSource="{Binding CPictureSet.ShedSetBut.Current}"    Grid.Row="2"  Grid.Column="3"  Style="{StaticResource SettingsButtons}"
                 Command="{Binding ShedulerTableCommand}"  Pressed="ShedSettings_Pressed" Released="ShedSettings_Released" IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.ModesSetBut.Current}" Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource SettingsButtons}"
                Command="{Binding SetSPCommand}"  Pressed="SPSettings_Pressed" Released="SPSettings_Released"  IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.SettingsOtherBut.Current}" Grid.Row="2" Grid.Column="14" Style="{StaticResource SettingsButtons}"
              Command="{Binding OtherSettingsCommand}"  Pressed="OtherSettings_Pressed" Released="OtherSettings_Released"  IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <!--#endregion-->
            <!--#region Нижний уровень -->
            <Button ImageSource="{Binding  CPictureSet.InformationBut.Current}" Grid.Row="6"  Grid.Column="3" 
                Style="{StaticResource SettingsButtons}"   Command="{Binding InformationCommand}"  
                Pressed="InformationSettings_Pressed"  Released="InformationSettings_Released" IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <Button ImageSource="{Binding  CPictureSet.JournalBut.Current}"    Grid.Row="6"  Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource SettingsButtons}" 
               Command="{Binding JournalCommand}"  Pressed="Journal_Pressed" Released="Journal_Released" IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <Button ImageSource="{Binding  CPictureSet.HelperBut.Current}"    Grid.Row="6"   Grid.Column="14" Style="{StaticResource SettingsButtons}" 
                Command="{Binding HelperCommand}"  Pressed="HelperSettings_Pressed" 
                                                          Released="HelperSettings_Released" IsVisible="{Binding CActivePagesEntities.IsSettingsPage}"/>
            <!--#endregion-->
            <!--#endregion-->

            <!--#region INFORMATION PAGE -->
            <Label Text="Информация" Grid.Row="1"   Style="{StaticResource Title}"    IsVisible = "{Binding   CActivePagesEntities.IsInformationPage}"/>
            <Button  ImageSource="{Binding  CPictureSet.BackButton.Current}" Style="{StaticResource BackBut}"
                Command="{Binding SettingsCommand}" Pressed="BackButton_Pressed" Released="BackButton_Released" IsVisible="{Binding CActivePagesEntities.IsInformationPage}"/>
            <!--#region Рекуператор -->
            <VerticalStackLayout   Grid.Row="2" Grid.RowSpan="1" Grid.Column="1"  Grid.ColumnSpan="8" IsVisible="{Binding CActivePagesEntities.IsInformationPage}" >
                <HorizontalStackLayout>
                    <Image Source="{Binding CPictureSet.RecupInfo}" Style="{StaticResource InfoImage}" />
                    <Label Text="Рекуператор" Style="{StaticResource InfoTopic}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Возд. на рекуператор,"  Style="{StaticResource InfoLabel}" />
                    <Label Text="{Binding CFBs.CRecup.RecPerc, StringFormat=' {0} %'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="КПД рекуператора," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding  CFBs.CRecup.Efficiency, StringFormat=' {0} %'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Обороты ротора," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding  CFBs.CRecup.Turns, StringFormat=' {0} об/мин'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
            <!--</VerticalStackLayout>-->
            <!--#endregion-->
            <!--#region Нагреватель -->
            <!--<VerticalStackLayout  Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="8" IsVisible="{Binding CActivePagesEntities.IsInformationPage}">-->
                <HorizontalStackLayout>
                    <Image Source="{Binding CPictureSet.EHeaterInfo}" Style="{StaticResource InfoImage}" />
                    <Label Text="Нагреватель" Style="{StaticResource InfoTopic}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Возд. на нагреватель ТЭН,"  Style="{StaticResource InfoLabel}" />
                    <Label Text="{Binding  CFBs.CEHSetPoints.CPower, StringFormat=' {0} %'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Огр. нагревателя ТЭН," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding CModesEntities.CMode1.ThreshPerc.Value, StringFormat=' {0} %'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Возд. на водяной калорифер," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding CFBs.CWHSetPoints.DamperPerc, StringFormat=' {0} %'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <!--#endregion-->
            <!--#region Датчики температуры -->
                <HorizontalStackLayout>
                    <Image Source="{Binding CPictureSet.TempInfo}" Style="{StaticResource InfoImage}" />
                    <Label Text="Датчики температуры" Style="{StaticResource InfoTopic}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Уставка t,"  Style="{StaticResource InfoLabel}" />
                    <Label Text="{Binding CModesEntities.CMode1.TempSP.Value, StringFormat=' {0} °C'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="t в канале," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding CFBs.CSensors.SupTemp.Value.Value,StringFormat=' {0} °C'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="t в помещении," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding CFBs.CSensors.RoomTemp.Value.Value,StringFormat=' {0} °C'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="t наружного воздуха," Style="{StaticResource InfoLabel}"/>
                    <Label Text="{Binding CFBs.CSensors.OutdoorTemp.Value.Value,StringFormat=' {0} °C'}" Style="{StaticResource InfoLabel}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="t удаляемого воздуха," Style="{StaticResource InfoLabel}"/>
