<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:Android_Silver.Services"
              xmlns:context="clr-namespace:Android_Silver.Pages"
              x:Class="Android_Silver.Pages.ServicePage"
              x:Name="SPage"
               BackgroundImageSource="{Binding CPictureSet.Background}">
    <ContentPage.Resources>
        <local:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <Style TargetType="Entry" x:Key="EntryPass">
            <Setter Property="MaxLength" Value="4"/>
            <Setter Property="IsPassword" Value="true" />
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Keyboard" Value="Numeric"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style TargetType="Entry" x:Key="EntryIP">
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="MaximumWidthRequest" Value="100"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Keyboard" Value="Numeric"/>
        </Style>
        <Style TargetType="Entry" x:Key="EntryNum" BasedOn="{StaticResource EntryIP}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Grid.ColumnSpan" Value="5"/>
            <Setter Property="MaximumWidthRequest" Value="140"/>
            <Setter Property="MaximumHeightRequest" Value="40"/>
            <Setter Property="MaxLength" Value="6"/>
            <Setter Property="BackgroundColor" Value="White"/>
        </Style>
        <Style TargetType="Picker" x:Key="ConfPicker">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Grid.ColumnSpan" Value="5"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="MaximumWidthRequest" Value="140"/>
            <Setter Property="MaximumHeightRequest" Value="40"/>
        </Style>
        <Style TargetType="Button" x:Key="BaseSettingsBut">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="Grid.ColumnSpan" Value="14" />
            <Setter Property="Grid.RowSpan" Value="1"  />
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style TargetType="Label" x:Key="OtherSettingsLabel">
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Grid.ColumnSpan" Value="14"/>
            <Setter Property="Grid.RowSpan" Value="1"/>
            <Setter Property="ZIndex" Value="0"/>
        </Style>
        <Style TargetType="Label" x:Key="FanSettingsLabel" BasedOn="{StaticResource OtherSettingsLabel}">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="HorizontalTextAlignment" Value="Start"/>
            <Setter Property="Grid.ColumnSpan" Value="12"/>
        </Style>
        <Style TargetType="Label" x:Key="ServiceTitle">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Setter Property="Grid.Column" Value="4"/>
            <Setter Property="Grid.ColumnSpan" Value="10"/>
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style TargetType="Entry" x:Key="EntryText">
            <Setter Property="Grid.ColumnSpan" Value="14"/>
            <Setter Property="Background" Value= "Transparent"/>
            <Setter Property="HorizontalTextAlignment" Value="Start" />
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="MaximumHeightRequest" Value="100" />
            <Setter Property="MaximumWidthRequest" Value="500" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray600}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style TargetType="Entry" x:Key="EntryMainMenu" BasedOn="{StaticResource EntryText}" >
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>
        <Style TargetType="CollectionView" x:Key="CollectionViews">
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="SelectionMode" Value="None"/>
            <Setter Property="Grid.ColumnSpan" Value="18"/>
            <Setter Property="Grid.RowSpan" Value="0" />
            <Setter Property="HeightRequest" Value="{Binding MenuHeight}"/>
            <Setter Property="VerticalOptions" Value="Start"/>
        </Style>
        <Style TargetType="CollectionView" x:Key="MainMenuCollectionViews" BasedOn="{StaticResource CollectionViews}">
            <!--<Setter Property="HeightRequest" Value="{Binding MainMenuHeight}"/>-->
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </ContentPage.Resources>
    <Grid x:Name="mainPageGrid" ColumnSpacing="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--#region StartPage -->
        <Label Text="{Binding EthernetEntities.EthernetMessage}" Grid.Row="2" FontSize="15" Grid.ColumnSpan="18"  HorizontalTextAlignment="Center" 
                   IsVisible="{Binding CActivePagesEntities.IsStartPage}" />
        <Border  Grid.Row="4" Grid.RowSpan="2" Grid.Column="3"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}">
            <Border.StrokeShape>
                <RoundRectangle/>
            </Border.StrokeShape>
            <Entry Text="{Binding EthernetEntities.IP1}" Placeholder="192" Style="{StaticResource EntryIP}"/>
        </Border>
        <Border   Grid.Row="4" Grid.RowSpan="2" Grid.Column="6"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
            <Border.StrokeShape>
                <RoundRectangle/>
            </Border.StrokeShape>
            <Entry Text="{Binding EthernetEntities.IP2}"  Placeholder="168" Style="{StaticResource EntryIP}"/>
        </Border>
        <Border  Grid.Row="4" Grid.RowSpan="2" Grid.Column="9"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
            <Border.StrokeShape>
                <RoundRectangle/>
            </Border.StrokeShape>
            <Entry Text="{Binding EthernetEntities.IP3}" Placeholder="0" Style="{StaticResource EntryIP}"/>
        </Border>
        <Border  Grid.Row="4" Grid.RowSpan="2" Grid.Column="12"  IsVisible="{Binding CActivePagesEntities.IsStartPage}" Style="{StaticResource PassBorder}" >
            <Border.StrokeShape>
                <RoundRectangle/>
            </Border.StrokeShape>
            <Entry Text="{Binding EthernetEntities.IP4}" Placeholder="50" Style="{StaticResource EntryIP}"/>
        </Border>
        <Button  ImageSource="{Binding CPictureSet.IPBut.Current}"  Command="{Binding StartPageConnectCommand}"  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="18"
                     Pressed="IPButton_Pressed" Released="IPButton_Released" Style="{StaticResource OKCancelBut}"
                                                 IsVisible="{Binding CActivePagesEntities.IsStartPage}" />
        <!--#endregion-->
        <!--#region Entry page -->
        <Label Text="{Binding EntryMessage}" Grid.Row="2" FontSize="15" Grid.Column="0" Grid.ColumnSpan="18"  
                                                                      IsVisible="{Binding CActivePagesEntities.IsEntryPage}"/>
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="18" Grid.RowSpan="2"  IsVisible="{Binding CActivePagesEntities.IsEntryPage}">
            <Border.StrokeShape>
                <RoundRectangle/>
            </Border.StrokeShape>
            <Entry Placeholder="****" Text="{Binding EntryPass}"  Style="{StaticResource EntryPass}"/>
        </Border>

        <Button  ImageSource="{Binding CPictureSet.IPBut.Current}"  Command="{Binding EntryPassedCommand}"
                    Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="18"
                    Style="{StaticResource OKCancelBut}"  IsVisible="{Binding CActivePagesEntities.IsEntryPage}" />
        <!--#endregion-->
        
        <!--#region Base settings page -->
        <Label Text="Окно настроек"  Grid.Row="1" Style="{StaticResource Title}"
                                          IsVisible = "{Binding CActivePagesEntities.IsBaseSettingsPage}"/>
        <CollectionView ItemsSource="{Binding  CMenusEntities.MenusCollection}"  Grid.Row="2"
                      Style="{StaticResource MainMenuCollectionViews}" IsVisible="{Binding CActivePagesEntities.IsBaseSettingsPage}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button  Grid.Column="2" Style="{StaticResource BaseSettingsBut}" ImageSource="{Binding ImgSource.Current}" 
                                             Command="{Binding Source={x:Reference SPage}, Path=BindingContext.ToSettingsCommand}"
                                             CommandParameter="{Binding ID}" Pressed="BaseSettings1Pressed" Released="BaseSettings1Released"  IsVisible="{Binding MenuIsVisible}"/>
                            <Entry Text="{Binding Name}"  Grid.Column="2" Style="{StaticResource EntryMainMenu}" IsVisible="{Binding MenuIsVisible}" InputTransparent="True"/>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--#endregion-->
        <!--#endregion-->
        <!--#region  Settings page -->
        <!--#region Header -->
        <Button ImageSource="{Binding CPictureSet.BackButton.Current}"  Command="{Binding FanReturnCommand}" Grid.Row="1"
                 Style="{StaticResource BackBut}"  Pressed="BackButton_Pressed"  Released="BackButton_Released" 
                                                IsVisible = "{Binding CActivePagesEntities.IsFBSettingsPage}"/>
        <Label Text="{Binding CMenusEntities.Title}" Style="{StaticResource ServiceTitle}" 
                                                            IsVisible = "{Binding CActivePagesEntities.IsFBSettingsPage}"/>
        <Button  ImageSource="{Binding CPictureSet.IPBut.Current}" Grid.Row="1"  Command="{Binding  SetSettingsCommand}"  
        Pressed="IPButton_Pressed" Released="IPButton_Released" Style="{StaticResource OKCancelBut}"
                                                                                                IsVisible = "{Binding CActivePagesEntities.IsFBSettingsPage}" />
        <!--#endregion-->
        <CollectionView ItemsSource="{Binding  CMenusEntities.InterfaceStrCollection}" Grid.Row="2" 
                Style="{StaticResource CollectionViews}"  IsVisible="{Binding CActivePagesEntities.IsFBSettingsPage}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--IsToggled="{Binding  CFBs.OtherSettings.IsSpecMode, Mode=TwoWay}"-->
                            <Entry Text="{Binding Name}" Style="{StaticResource EntryText}" IsVisible = "{Binding IsVisible}"  IsReadOnly="True"/>
                            <Switch Grid.Column="8" Grid.ColumnSpan="3"  IsVisible = "{Binding SwitchIsActive}"  IsToggled="{Binding SwitchIsOn}" />
                            <Entry Style="{StaticResource EntryNum}" Text="{Binding CVal}"
                                           ReturnCommand="{Binding Source={RelativeSource AncestorType={x:Type context:ServicePage}},Path=BindingContext.SetEntryCommand}" 
                                           ReturnCommandParameter="{Binding .}" Grid.Column="12" IsVisible = "{Binding EIsVisible}" IsEnabled="{Binding IsEnabled}" />
                            <Picker Style="{StaticResource ConfPicker}"  SelectedIndexChanged="Picker_SelectedIndexChanged" ItemsSource="{Binding PickVals}" 
                                            SelectedIndex="{Binding CPickVal}" Grid.Column="12"  IsVisible = "{Binding PickerIsVisible}" IsEnabled="{Binding IsEnabled}"/>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--#endregion-->
        <!--#region LOADING PAGE -->
        <Button ImageSource="{Binding CPictureSet.BackButton.Current}"  Command="{Binding HomeCommand}" 
                Style="{StaticResource BackBut}"  Pressed="BackButton_Pressed"  Released="BackButton_Released" IsVisible = "{Binding CActivePagesEntities.IsLoadingPage}"/>
        <Image Source="{Binding  CPictureSet.LoadingPic}" IsVisible="{Binding CActivePagesEntities.IsLoadingPage}"
                                                 Grid.Row="3"  Grid.RowSpan="4" Grid.Column="8" Grid.ColumnSpan="2"  WidthRequest="400"
                   HorizontalOptions="Center"/>
        <Label Text="Загрузка..." Grid.Row="7" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="18" FontSize="30" IsVisible="{Binding CActivePagesEntities.IsLoadingPage}"/>
        <!--#endregion-->

        <Label Text="{Binding EthernetEntities.SystemMessage}"  Grid.Row="13" Grid.RowSpan="1"  Grid.Column="0" Grid.ColumnSpan="8"
             IsVisible="{Binding CActivePagesEntities.IsBaseSettingsPage}"/>
    </Grid>
</ContentPage>